{
  "name": "market-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Bloomberg-style market terminal (read-only research/analytics; no trading).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
